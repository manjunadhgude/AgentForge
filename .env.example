# Copy to .env for local development, then set real values only in your local file.
# Never commit .env or paste API/database tokens into source code.
AGENTFORGE_DB_HOST=127.0.0.1
AGENTFORGE_DB_PORT=5432
AGENTFORGE_DB_NAME=agentforge
AGENTFORGE_DB_USER=agentforge
AGENTFORGE_DB_PASSWORD=replace-with-local-database-password
AGENTFORGE_API_TOKEN=replace-with-random-token-at-least-32-characters
AGENTFORGE_APPROVER_TOKEN=replace-with-a-different-random-token-at-least-32-characters
AGENTFORGE_APPROVER_ID=local-reviewer
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_MODEL=
AGENTFORGE_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
AGENTFORGE_LLM_TIMEOUT_SECONDS=20
AGENTFORGE_LLM_MAX_ATTEMPTS=2
